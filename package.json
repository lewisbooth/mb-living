{
  "name": "mb-living",
  "version": "1.0.0",
  "private": true,
  "description": "MB Living static site built from Pug, Stylus and Vite",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/version-assets.mjs",
    "preview": "vite preview",
    "verify": "node scripts/verify-build.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "devDependencies": {
    "autoprefixer": "10.6.1",
    "postcss": "8.5.28",
    "pug": "3.0.4",
    "stylus": "0.64.0",
    "vite": "8.3.0",
    "wrangler": "4.137.0"
  }
}
