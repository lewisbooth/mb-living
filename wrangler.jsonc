{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mb-living",
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}
